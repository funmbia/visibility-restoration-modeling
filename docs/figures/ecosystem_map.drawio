        <mxCell id="BPJuGf61nl9VA2Lk4lcC-155" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#4D4D4D;fillColor=none;align=left;verticalAlign=middle;rounded=0;shadow=0;perimeterSpacing=0;glass=0;spacingLeft=10;spacingTop=0;spacingRight=10;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;u&gt;ANNOTATIONS&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;[A1]&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Assuming the existence of a video-hosting infrastructure that houses all video metadata on YouTube&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;[A2]&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Assuming separate Moderation and Appeals teams&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;u&gt;&lt;b&gt;BOUNDARY OF THE ECOSYSTEM MAP&lt;/b&gt;&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Included: &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Video publication, moderation, removal, appeals, reinstatement, and recommendation.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Excluded:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Actual impressions, views, likes, comments, and other audience engagement signals. Also excluded are watch history, search history, subscriptions, and other actual recommendation signals.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="710" x="930" y="720" as="geometry" />
        </mxCell>
        <mxCell id="BPJuGf61nl9VA2Lk4lcC-156" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=4" value="&lt;span style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;span style=&quot;font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif;&quot;&gt;&lt;b&gt;YouTube&#39;s content moderation, appeals, reinstatement, and recommendation arrangement&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="627" x="962" y="80" as="geometry" />
